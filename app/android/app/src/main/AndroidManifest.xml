<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- audited: local reminder notifications (p1.7; per-category since p4.1).
         Shows only the local notifications the user turns on in the Notifications
         settings screen. No network. Reviewed 2026-08-29 worker: phase1; screen
         name updated 2026-09-02 worker: phase4 (p4.6). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- audited: local reminder notifications (p1.7; per-category since p4.1).
         Lets flutter_local_notifications re-register pending reminders after a
         restart so they keep firing. No network. Reviewed 2026-08-29
         worker: phase1. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- audited: p2.1 biometric unlock. Lets local_auth show the system
         fingerprint / face prompt as an opt-in shortcut past the app PIN. No
         biometric data is read by the app and none leaves the device; the OS
         only returns pass/fail. Reviewed 2026-08-30 by worker: phase2. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- audited: p6.3 Health Connect bridge, opt-in ("Connect a health app",
         default off). Read half of the menstrual-flow sync. User grants/revokes
         in Health Connect's own sheet; data crosses over local IPC only
         (androidx.health.connect), never the network. 2026-09-05 worker: phase1. -->
    <uses-permission android:name="android.permission.health.READ_MENSTRUATION" />
    <!-- audited: p6.3 Health Connect bridge — write half of the menstrual-flow
         sync (olf's own entries back to Health Connect). Scope + revocation as
         for READ_MENSTRUATION above; local IPC only, no network. 2026-09-05
         worker: phase1. -->
    <uses-permission android:name="android.permission.health.WRITE_MENSTRUATION" />
    <!-- audited: p6.3 Health Connect bridge — read half of the basal-body-
         temperature sync. Scope + revocation as for READ_MENSTRUATION above;
         local IPC only, no network. 2026-09-05 worker: phase1. -->
    <uses-permission android:name="android.permission.health.READ_BASAL_BODY_TEMPERATURE" />
    <!-- audited: p6.3 Health Connect bridge — write half of the basal-body-
         temperature sync. Scope + revocation as for READ_MENSTRUATION above;
         local IPC only, no network. 2026-09-05 worker: phase1. -->
    <uses-permission android:name="android.permission.health.WRITE_BASAL_BODY_TEMPERATURE" />
    <application
        android:label="olf"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- p5.4: the LAUNCHER intent-filter lives on the activity-alias
                 declarations below, not here, so the home-screen icon/name can
                 be swapped by enabling one alias and disabling the other. -->
            <!-- p6.3: Health Connect opens its permissions sheet from the
                 provider app; this lets it deep-link back to olf's own
                 rationale (the "Connect a health app" tile explains the two
                 shared data types and how to turn the bridge off). -->
            <intent-filter>
                <action android:name="androidx.health.connect.action.SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <!-- p5.4 discreet-presence icon switch. Exactly one alias is enabled at
             a time; MainActivity.kt's `olf/app_icon` method channel toggles
             them with PackageManager.setComponentEnabledSetting. "Branded" is
             the default (enabled here); "Notes" is a plain unlabelled icon.
             No new permission — activity-alias needs none. -->
        <activity-alias
            android:name=".MainActivityBranded"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="olf">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".MainActivityNotes"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_notes"
            android:label="Notes">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- p6.3: package visibility (Android 11+) so HealthConnectClient
             .getSdkStatus() can see the Health Connect provider and report
             whether the bridge is usable. Not a permission — just visibility. -->
        <package android:name="com.google.android.apps.healthdata" />
    </queries>
</manifest>
